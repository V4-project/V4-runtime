# ESP32-C6 device configuration
# Copy this file to .env and adjust the device path as needed
#
# Common device paths:
#   - Linux: /dev/ttyACM0, /dev/ttyACM1, /dev/ttyUSB0
#   - macOS: /dev/cu.usbmodem*, /dev/cu.usbserial-*
#   - Windows (WSL): /dev/ttyACM0, /dev/ttyUSB0

ESP_DEVICE=/dev/ttyACM0

# Project directory (defaults to runtime if not specified)
# Use /project/bsp/esp32c6/runtime for runtime
# Use /project/bsp/esp32c6/repl for REPL (future)
PROJECT_DIR=/project/bsp/esp32c6/runtime
